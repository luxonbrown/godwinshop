# ==============================================================================
# GodwinShop — Environment configuration
# Copy this file to `server/.env` and fill in your values.
# NEVER commit the real server/.env file.
# ==============================================================================

# --- Server ---
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=godwinshop
DB_USER=root
DB_PASSWORD=

# --- Sessions (see Section 61: Secure Session Management) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
# Session lifetime in milliseconds (default 24h = 86400000)
SESSION_MAX_AGE=86400000
# WARN: set to true when the site is served over HTTPS.
# In local development over http, keep it false (cookie requires secure=true over https only).
SESSION_COOKIE_SECURE=false

# --- Default admin (used by `npm run setup` / seed) ---
# NEVER use these credentials in production. Change them after the first login.
ADMIN_NAME=Godwin Admin
ADMIN_EMAIL=admin@godwinshop.com
ADMIN_PHONE=+15550000000
ADMIN_PASSWORD=GodwinAdmin123

# --- Email (real Gmail verification) ---
# Requires a Gmail App Password (16 chars, spaces OK): myaccount.google.com —
# Security > 2-Step Verification > App passwords. You need 2FA enabled first.
# A normal Gmail account password will NOT work with SMTP.
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="GodwinShop <yourgmail@gmail.com>"

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5